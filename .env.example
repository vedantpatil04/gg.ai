# GreenGuard AI — Frontend environment variables
# Copy this file to .env and fill in your values

# Backend API URL — points to your Express backend
VITE_API_URL=https://gg-ai-11ja.onrender.com/api

# Cloudflare Turnstile CAPTCHA (Public Site Key)
# In production, generate keys in Cloudflare Dashboard -> Turnstile.
# Cloudflare official testing sitekey: 1x00000000000000000000AA (always passes)
VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key_here

