# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get your free cluster at https://cloud.mongodb.com
MONGODB_URI=MONGODB_URI=mongodb+srv://vedantpatilbca_db_user:Admin1234@cluster0.abcde.mongodb.net/greenguard?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_64_char_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_a_different_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email Delivery ──────────────────────────────────────────────────────────
# Production on Render Free tier requires an HTTPS-based email provider (ports 25/465/587 blocked).
# Resend (Recommended HTTPS API): Get a free key at https://resend.com (3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=GreenGuard AI <onboarding@resend.dev>

# Optional alternative HTTPS provider: Brevo (Sendinblue)
# BREVO_API_KEY=your_brevo_api_key_here

# Local Development / Direct SMTP (optional fallback for localhost)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=GreenGuard AI <noreply@greenguard.ai>

# ─── Gemini AI (AI features degrade gracefully without this) ──────────────────
# Get your free API key at https://ai.google.dev/
# Free tier: 1,500 requests/day, 15 requests/minute
# Used by every GreenGuard AI module EXCEPT the /copilot Intelligence
# Center Assistant: Forecast, Sustainability, Reports, Policy Simulator,
# and other existing Gemini-powered functionality.
GEMINI_API_KEY=your_gemini_api_key_here

# ─── GreenGuard Intelligence Center (Phase 3) ──────────────────────────────────
# The /copilot Assistant's multi-provider reliability layer (Gemini Center +
# Groq + OpenRouter, Auto-mode fallback). Kept separate from GEMINI_API_KEY
# above so the Assistant's usage/quota never competes with the rest of the
# app, and so either key can be rotated independently.
#
# INTELLIGENCE_GEMINI_API_KEY — dedicated Gemini key for /copilot only.
# Get a free key at https://ai.google.dev/ (can be the same or a different
# Google AI Studio key from GEMINI_API_KEY above).
INTELLIGENCE_GEMINI_API_KEY=your_intelligence_gemini_api_key_here

# GROQ_API_KEY — get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OPENROUTER_API_KEY — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides for the Assistant's reliability policy — safe
# defaults are used when unset (see backend/src/services/ai/config.ts).
# AI_PROVIDER_TIMEOUT_MS=20000
# AI_PROVIDER_COOLDOWN_THRESHOLD=2
# AI_PROVIDER_COOLDOWN_MS=60000
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_SITE_URL=https://your-greenguard-deployment.example.com

# ─── Phase 4: Real Environmental Data APIs ────────────────────────────────────
# OpenWeather API — Air Pollution + Current Weather
# Get your free key at https://openweathermap.org/api
# Free tier: 1,000 calls/day
OPENWEATHER_API_KEY=your_openweather_api_key_here

# WAQI (World Air Quality Index) API — fallback AQI source
# Get your free token at https://aqicn.org/data-platform/token/
WAQI_API_KEY=your_waqi_token_here

# ─── Firebase Cloud Messaging (Phase 3 — optional push notifications) ────────
# Generate a service account private key in Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_service_account_private_key_here\n-----END PRIVATE KEY-----\n"


# ─── Forecast Center — Real Forecast Data Foundation (Phase 1) ────────────────
# Hourly/daily weather + air-quality FORECAST data (as opposed to the current
# conditions above) comes from Open-Meteo (https://open-meteo.com/en/docs).
# No API key or env var is required — it's free for non-commercial use.
# If GreenGuard is deployed commercially at scale, review
# https://open-meteo.com/en/pricing and add a customer- prefixed hostname
# + apikey per their docs before relying on it in production.

# ─── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── Cloudflare Turnstile CAPTCHA ─────────────────────────────────────────────
# Private Turnstile Secret Key for server-side verification.
# In production, generate keys in Cloudflare Dashboard -> Turnstile.
# Cloudflare official testing secret: 1x0000000000000000000000000000000AA (always passes)
TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key_here

