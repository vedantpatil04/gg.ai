{
  "name": "greenguard-ai",
  "version": "1.0.0",
  "private": true,
  "description": "GreenGuard AI — Environmental Intelligence Platform",
  "scripts": {
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"green,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd . && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "install:all": "npm install && cd backend && npm install",
    "seed": "cd backend && npm run seed",
    "build": "npm run build --workspace=.",
    "lint": "npm run lint --workspace=."
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
