<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar / background-notification icon for GreenGuard AI push
  notifications (Phase 3). Android requires a flat, single-color
  silhouette for this — the system renders only its alpha channel, so
  fillColor is white by convention regardless of theme. Do not reuse the
  full-color launcher icon here; see AndroidManifest.xml's
  default_notification_icon meta-data for where this is wired up.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Shield outline (stroke only, no fill) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,2.5 L18.5,5 V11 C18.5,15.2 15.8,18.9 12,20.3 C8.2,18.9 5.5,15.2 5.5,11 V5 Z" />
    <!-- Checkmark, same stroke so it stays visible against the outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9,11.3 L11,13.3 L15,9.3" />
</vector>
